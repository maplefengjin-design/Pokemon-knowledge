{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/pokemon-fact.schema.json",
  "title": "Versioned Pokémon Fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id",
    "subject",
    "predicate",
    "value",
    "context",
    "evidence",
    "status"
  ],
  "properties": {
    "fact_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "canonical_id"],
      "properties": {
        "entity_type": {
          "enum": ["pokemon_species", "pokemon_form", "move", "ability", "item", "type", "rule", "document"]
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "unit": {
      "type": ["string", "null"]
    },
    "language": {
      "type": ["string", "null"],
      "examples": ["zh-Hans", "zh-Hant", "ja", "en"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition_id", "domain"],
      "properties": {
        "edition_id": {
          "enum": ["mainline", "pokemmo"]
        },
        "domain": {
          "enum": ["core_game", "tcg", "anime", "go", "unite", "competitive"]
        },
        "generation": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "games": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "version_group": {
          "type": ["string", "null"]
        },
        "form_id": {
          "type": ["string", "null"]
        },
        "ruleset": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_ref", "authority_tier", "fetched_at", "content_sha256"],
      "properties": {
        "source_id": {"type": "string"},
        "source_ref": {"type": "string"},
        "upstream_commit": {"type": ["string", "null"]},
        "authority_tier": {"enum": ["A", "B", "C", "D", "E"]},
        "license": {"type": ["string", "null"]},
        "fetched_at": {"type": "string", "format": "date-time"},
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": ["verified", "community_verified", "unverified", "conflicted", "deprecated"]
    },
    "uncertainty_reason": {
      "type": ["string", "null"]
    },
    "effective_from": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "effective_to": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
