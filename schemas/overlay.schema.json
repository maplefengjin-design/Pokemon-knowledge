{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/pokemmo-overlay.schema.json",
  "title": "PokeMMO Fact Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overlay_id",
    "edition_id",
    "subject",
    "predicate",
    "resolution",
    "evidence",
    "review"
  ],
  "properties": {
    "overlay_id": {"type": "string", "minLength": 1},
    "edition_id": {"const": "pokemmo"},
    "base_fact_id": {"type": ["string", "null"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "canonical_id"],
      "properties": {
        "entity_type": {
          "enum": ["pokemon_species", "pokemon_form", "move", "ability", "item", "type", "rule", "location", "encounter"]
        },
        "canonical_id": {"type": "string", "minLength": 1}
      }
    },
    "predicate": {"type": "string", "minLength": 1},
    "resolution": {
      "enum": ["override", "same_as_base", "absent", "not_applicable", "unknown"]
    },
    "value": {},
    "effective_from": {"type": ["string", "null"], "format": "date-time"},
    "effective_to": {"type": ["string", "null"], "format": "date-time"},
    "supersedes_overlay_id": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_ref", "fetched_at", "content_sha256"],
        "properties": {
          "source_id": {"type": "string"},
          "source_ref": {"type": "string"},
          "upstream_commit": {"type": ["string", "null"]},
          "fetched_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["candidate", "verified", "recheck_required", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"resolution": {"const": "override"}}},
      "then": {"required": ["value"]}
    },
    {
      "if": {"properties": {"resolution": {"const": "same_as_base"}}},
      "then": {
        "required": ["base_fact_id"],
        "properties": {"base_fact_id": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
