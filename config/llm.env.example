# 复制本文件为 config/llm.env 后填写。llm.env 已被 .gitignore 排除。
POKEMON_LLM_ENABLED=true

# OpenAI 推荐使用 Responses API。许多本地/第三方兼容服务使用 chat-completions。
POKEMON_LLM_PROTOCOL=responses
POKEMON_LLM_BASE_URL=https://api.openai.com/v1
POKEMON_LLM_MODEL=
POKEMON_LLM_API_KEY=

POKEMON_LLM_TIMEOUT_SECONDS=60
POKEMON_LLM_MAX_TOOL_ROUNDS=6
POKEMON_LLM_TRACE=true
