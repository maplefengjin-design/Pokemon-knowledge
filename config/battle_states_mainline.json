  "source_id": "pokemon-showdown",
  "categories": [
    {"identifier":"pokemon_status","label_zh":"宝可梦自身状态","scope":"pokemon","description_zh":"附着在单只宝可梦上的主要异常状态或临时状态；主要异常通常互斥，临时状态可并存。","sort_order":10},
    {"identifier":"side_condition","label_zh":"队伍侧场地状态","scope":"side","description_zh":"只作用于一名训练家的场地一侧，包括墙、白雾、顺风、撒钉和誓约组合效果。","sort_order":20},
    {"identifier":"weather","label_zh":"天气","scope":"field","description_zh":"覆盖整个战场的天气系统；通常同一时刻只有一种天气生效。","sort_order":30},
    {"identifier":"terrain","label_zh":"场地","scope":"field","description_zh":"电气、青草、薄雾和精神场地；多数核心效果只影响处于地面上的宝可梦。","sort_order":40},
    {"identifier":"field_condition","label_zh":"全场规则状态","scope":"field","description_zh":"不属于天气或四种场地、但会改变全场规则的空间和全局效果，例如戏法空间、重力。","sort_order":50},
    {"identifier":"aura","label_zh":"气场与全场特性效果","scope":"field","description_zh":"由在场宝可梦的特性持续提供、会影响场上其他对象或某类招式的全场效果。","sort_order":60}
  ],
  "states": [
    {"identifier":"burn","name_zh":"灼伤","aliases":["烧伤","burn","brn"],"category":"pokemon_status","subcategory":"major_status","scope":"pokemon","generation_from":1,"description_zh":"主要异常状态；通常与中毒、麻痹、睡眠和冰冻互斥。","mechanics_zh":"当前主系列规则下每回合损失最大HP的1/16，物理招式造成的伤害通常减半；毅力等效果可改变实际影响。","counterplay_zh":"可用状态回复道具、治愈铃声、芳香治疗或特定特性解除。","parameters":{"exclusive_group":"major_status","residual_hp_fraction":"1/16","physical_damage_multiplier":"1/2"},"source_locator":"conditions.ts#brn","relations":[{"entity_type":"move","identifier":"will-o-wisp","relation_kind":"applies","note_zh":"直接施加灼伤"}]},
    {"identifier":"paralysis","name_zh":"麻痹","aliases":["麻痹状态","paralysis","par"],"category":"pokemon_status","subcategory":"major_status","scope":"pokemon","generation_from":1,"description_zh":"主要异常状态，会降低行动速度并可能使行动失败。","mechanics_zh":"当前规则下速度通常变为50%，每次行动有25%概率因麻痹而无法使出招式。","counterplay_zh":"地面属性只免疫多数电属性施加手段，并不普遍免疫麻痹本身；可通过状态回复效果解除。","parameters":{"exclusive_group":"major_status","speed_multiplier":"1/2","full_paralysis_chance":"1/4"},"source_locator":"conditions.ts#par","relations":[{"entity_type":"move","identifier":"thunder-wave","relation_kind":"applies","note_zh":"施加麻痹"},{"entity_type":"move","identifier":"nuzzle","relation_kind":"applies","note_zh":"造成伤害并施加麻痹"}]},
    {"identifier":"sleep","name_zh":"睡眠","aliases":["睡着","睡眠状态","sleep","slp"],"category":"pokemon_status","subcategory":"major_status","scope":"pokemon","generation_from":1,"description_zh":"主要异常状态，通常不能使用普通招式。","mechanics_zh":"当前规则下自然睡眠计数通常为1至3个完整不能行动的回合；梦话和打鼾等招式可在睡眠时使用。","counterplay_zh":"换下不会清除睡眠计数；可用唤醒类道具、治愈铃声等解除。","parameters":{"exclusive_group":"major_status","natural_turns":"1-3"},"source_locator":"conditions.ts#slp","relations":[{"entity_type":"move","identifier":"spore","relation_kind":"applies","note_zh":"高命中率施加睡眠"},{"entity_type":"move","identifier":"yawn","relation_kind":"delayed_apply","note_zh":"下一回合施加睡眠"}]},
    {"identifier":"freeze","name_zh":"冰冻","aliases":["冰冻状态","freeze","frz"],"category":"pokemon_status","subcategory":"major_status","scope":"pokemon","generation_from":1,"description_zh":"主要异常状态，可能令宝可梦无法行动。","mechanics_zh":"每次行动前通常有20%概率自然解冻；部分可解冻招式或受到火属性伤害也能解除。","counterplay_zh":"火属性宝可梦通常不会被冰冻；可使用解冻类道具或带解冻标记的招式。","parameters":{"exclusive_group":"major_status","natural_thaw_chance":"1/5"},"source_locator":"conditions.ts#frz","relations":[{"entity_type":"move","identifier":"ice-beam","relation_kind":"may_apply","note_zh":"有概率施加冰冻"}]},
    {"identifier":"poison","name_zh":"中毒","aliases":["普通中毒","poison","psn"],"category":"pokemon_status","subcategory":"major_status","scope":"pokemon","generation_from":1,"description_zh":"主要异常状态，持续损失HP。","mechanics_zh":"当前规则下每回合损失最大HP的1/8。","counterplay_zh":"毒属性和钢属性通常免疫多数中毒手段；可通过状态回复效果解除。","parameters":{"exclusive_group":"major_status","residual_hp_fraction":"1/8"},"source_locator":"conditions.ts#psn","relations":[{"entity_type":"move","identifier":"poison-powder","relation_kind":"applies","note_zh":"施加普通中毒"}]},
    {"identifier":"badly-poisoned","name_zh":"剧毒","aliases":["猛毒","严重中毒","badly poisoned","tox"],"category":"pokemon_status","subcategory":"major_status","scope":"pokemon","generation_from":1,"description_zh":"伤害逐回合增加的特殊中毒状态。","mechanics_zh":"伤害从最大HP的1/16开始，每回合提高一个1/16阶段；换下再上场后阶段重置。","counterplay_zh":"免疫与解除方式通常与中毒相同。","parameters":{"exclusive_group":"major_status","initial_hp_fraction":"1/16","stage_cap":15,"resets_on_switch":true},"source_locator":"conditions.ts#tox","relations":[{"entity_type":"move","identifier":"toxic","relation_kind":"applies","note_zh":"施加剧毒"}]},
    {"identifier":"confusion","name_zh":"混乱","aliases":["混乱状态","confusion"],"category":"pokemon_status","subcategory":"volatile_status","scope":"pokemon","generation_from":1,"description_zh":"可与主要异常并存的临时状态。","mechanics_zh":"当前规则通常持续2至5回合；行动时有33%概率攻击自己，自伤按威力40的无属性物理伤害计算。","counterplay_zh":"换下通常会解除；薄雾场地保护处于地面上的宝可梦免受混乱。","parameters":{"duration_turns":"2-5","self_hit_chance":"33/100","self_hit_power":40},"source_locator":"conditions.ts#confusion","relations":[{"entity_type":"move","identifier":"confuse-ray","relation_kind":"applies","note_zh":"施加混乱"}]},
    {"identifier":"flinch","name_zh":"畏缩","aliases":["害怕","flinch"],"category":"pokemon_status","subcategory":"volatile_status","scope":"pokemon","generation_from":1,"description_zh":"只影响当前回合行动的临时状态。","mechanics_zh":"目标在本回合轮到行动时无法使出招式；目标已经行动后再被施加通常没有实际效果。","counterplay_zh":"精神力等特性可免疫畏缩。","parameters":{"duration_turns":1},"source_locator":"conditions.ts#flinch","relations":[{"entity_type":"move","identifier":"fake-out","relation_kind":"applies","note_zh":"满足首回合条件时必定使目标畏缩"}]},
    {"identifier":"infatuation","name_zh":"着迷","aliases":["迷恋","着迷状态","infatuation","attract"],"category":"pokemon_status","subcategory":"volatile_status","scope":"pokemon","generation_from":2,"description_zh":"由性别条件产生的临时状态。","mechanics_zh":"每次尝试行动时通常有50%概率因着迷而无法行动；施加者离场或目标换下后解除。","counterplay_zh":"迟钝等特性可免疫，心灵香草等效果可解除部分限制状态。","parameters":{"immobilization_chance":"1/2","clears_on_switch":true},"source_locator":"moves.ts#attract","relations":[{"entity_type":"move","identifier":"attract","relation_kind":"applies","note_zh":"按性别条件施加着迷"}]},
    {"identifier":"leech-seed","name_zh":"寄生种子状态","aliases":["寄生种子","leech seed","seeded"],"category":"pokemon_status","subcategory":"volatile_status","scope":"pokemon","generation_from":1,"description_zh":"持续从目标吸取HP的临时状态。","mechanics_zh":"回合末通常扣除目标最大HP的1/8并回复施加方当前在场宝可梦；目标换下后解除。","counterplay_zh":"草属性通常免疫寄生种子；高速旋转可解除自身的寄生种子状态。","parameters":{"residual_hp_fraction":"1/8","clears_on_switch":true},"source_locator":"moves.ts#leechseed","relations":[{"entity_type":"move","identifier":"leech-seed","relation_kind":"applies","note_zh":"施加寄生种子"},{"entity_type":"move","identifier":"rapid-spin","relation_kind":"removes","note_zh":"解除使用者的寄生种子"}]},
    {"identifier":"taunt","name_zh":"挑衅状态","aliases":["挑衅","taunt"],"category":"pokemon_status","subcategory":"move_restriction","scope":"pokemon","generation_from":3,"description_zh":"限制目标选择变化招式的临时状态。","mechanics_zh":"当前规则通常持续3回合；期间目标不能选择大多数变化招式。","counterplay_zh":"换下可解除；心灵香草或芳香幕等效果可应对。","parameters":{"duration_turns":3},"source_locator":"moves.ts#taunt","relations":[{"entity_type":"move","identifier":"taunt","relation_kind":"applies","note_zh":"施加挑衅"}]},
    {"identifier":"encore","name_zh":"再来一次状态","aliases":["再来一次","encore状态","encore"],"category":"pokemon_status","subcategory":"move_restriction","scope":"pokemon","generation_from":2,"description_zh":"把目标锁定在最后使用招式上的临时状态。","mechanics_zh":"当前主系列通常持续3回合；若被锁招式无法继续使用，会按失败或解除规则处理。","counterplay_zh":"换下可解除；部分最后招式会令再来一次使用失败。","parameters":{"duration_turns":3},"source_locator":"moves.ts#encore","relations":[{"entity_type":"move","identifier":"encore","relation_kind":"applies","note_zh":"施加再来一次"}]},
    {"identifier":"torment","name_zh":"无理取闹状态","aliases":["无理取闹","torment"],"category":"pokemon_status","subcategory":"move_restriction","scope":"pokemon","generation_from":3,"description_zh":"阻止目标连续使用同一个招式。","mechanics_zh":"只要状态存在，目标不能连续两次选择相同招式；换下后解除。","counterplay_zh":"可通过换下或无视精神效果的特性应对。","parameters":{"clears_on_switch":true},"source_locator":"moves.ts#torment","relations":[{"entity_type":"move","identifier":"torment","relation_kind":"applies","note_zh":"施加无理取闹"}]},
    {"identifier":"disable","name_zh":"定身法状态","aliases":["定身法","disable"],"category":"pokemon_status","subcategory":"move_restriction","scope":"pokemon","generation_from":1,"description_zh":"暂时封锁目标最近使用的一个招式。","mechanics_zh":"当前规则通常持续4回合；被封锁招式期间不能选择。","counterplay_zh":"换下会解除；目标没有可用招式时可能被迫使用挣扎。","parameters":{"duration_turns":4},"source_locator":"moves.ts#disable","relations":[{"entity_type":"move","identifier":"disable","relation_kind":"applies","note_zh":"封锁最近使用的招式"}]},
    {"identifier":"drowsy","name_zh":"瞌睡","aliases":["哈欠状态","困倦","drowsy","yawn"],"category":"pokemon_status","subcategory":"delayed_status","scope":"pokemon","generation_from":3,"description_zh":"下一回合将转化为睡眠的延迟状态。","mechanics_zh":"在下一回合结束时尝试令目标睡眠；目标换下、已有主要异常或受场地保护时不会成功。","counterplay_zh":"及时换下、使用电气场地或薄雾场地等可阻止睡眠落地。","parameters":{"delay_turns":1,"clears_on_switch":true},"source_locator":"moves.ts#yawn","relations":[{"entity_type":"move","identifier":"yawn","relation_kind":"applies","note_zh":"施加瞌睡"}]},
    {"identifier":"substitute","name_zh":"替身状态","aliases":["替身","substitute"],"category":"pokemon_status","subcategory":"defensive_volatile","scope":"pokemon","generation_from":1,"description_zh":"用自身HP制造承受伤害和阻挡部分效果的替身。","mechanics_zh":"通常消耗最大HP的1/4，替身拥有相同数值的耐久；声音类招式和穿透类效果可能绕过替身。","counterplay_zh":"连续攻击、声音类招式、穿透特性或足够高的单次伤害可处理替身。","parameters":{"hp_cost_fraction":"1/4"},"source_locator":"moves.ts#substitute","relations":[{"entity_type":"move","identifier":"substitute","relation_kind":"applies","note_zh":"创建替身"}]},
    {"identifier":"trapped","name_zh":"无法逃走状态","aliases":["束缚换人","不能替换","trapped"],"category":"pokemon_status","subcategory":"switch_restriction","scope":"pokemon","generation_from":1,"description_zh":"阻止目标主动替换或逃走的状态。","mechanics_zh":"具体持续时间和解除条件取决于施加招式或特性；幽灵属性在较新世代通常可无视多数逃走限制。","counterplay_zh":"击倒施加者、满足招式解除条件、使用强制换人或特定道具/特性。","parameters":{},"source_locator":"conditions.ts#trapped","relations":[{"entity_type":"move","identifier":"mean-look","relation_kind":"applies","note_zh":"阻止目标替换"}]},
    {"identifier":"partially-trapped","name_zh":"绑紧状态","aliases":["部分束缚","持续束缚","partially trapped","bind"],"category":"pokemon_status","subcategory":"residual_trap","scope":"pokemon","generation_from":1,"description_zh":"同时造成持续伤害并限制替换的临时状态。","mechanics_zh":"当前规则通常持续4至5回合，每回合损失最大HP的1/8；紧缠钩爪和绑紧带可改变持续时间或伤害。","counterplay_zh":"高速旋转可解除使用者的绑紧状态；施加者失效时部分效果会结束。","parameters":{"duration_turns":"4-5","residual_hp_fraction":"1/8"},"source_locator":"conditions.ts#partiallytrapped","relations":[{"entity_type":"move","identifier":"bind","relation_kind":"applies","note_zh":"施加持续束缚"},{"entity_type":"move","identifier":"rapid-spin","relation_kind":"removes","note_zh":"解除使用者的持续束缚"}]},
    {"identifier":"perish-song","name_zh":"灭亡之歌倒计时","aliases":["灭亡倒计时","灭亡之歌状态","perish song"],"category":"pokemon_status","subcategory":"countdown","scope":"pokemon","generation_from":2,"description_zh":"倒计时归零时令目标陷入濒死的临时状态。","mechanics_zh":"通常从3开始逐回合减少；换下可解除自身倒计时。隔音可阻挡声音来源。","counterplay_zh":"在倒计时归零前换下。","parameters":{"initial_count":3,"clears_on_switch":true},"source_locator":"moves.ts#perishsong","relations":[{"entity_type":"move","identifier":"perish-song","relation_kind":"applies","note_zh":"为场上可听见的宝可梦设置倒计时"}]},
    {"identifier":"reflect","name_zh":"反射壁","aliases":["物理墙","Reflect"],"category":"side_condition","subcategory":"screen","scope":"side","generation_from":1,"description_zh":"作用于己方一侧、降低物理招式伤害的墙类状态。","mechanics_zh":"通常持续5回合，光之黏土可延长至8回合；单打伤害通常减半，双打等多人环境通常降至约2/3。","counterplay_zh":"除雾可清除；劈瓦、精神之牙等可破坏墙；穿透可绕过部分防护。","parameters":{"duration_turns":5,"extended_duration_turns":8,"single_multiplier":"1/2","multi_multiplier":"2/3"},"source_locator":"moves.ts#reflect","relations":[{"entity_type":"move","identifier":"reflect","relation_kind":"sets","note_zh":"设置反射壁"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方反射壁"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除反射壁"}]},
    {"identifier":"light-screen","name_zh":"光墙","aliases":["特殊墙","Light Screen"],"category":"side_condition","subcategory":"screen","scope":"side","generation_from":1,"description_zh":"作用于己方一侧、降低特殊招式伤害的墙类状态。","mechanics_zh":"通常持续5回合，光之黏土可延长至8回合；单打伤害通常减半，双打等多人环境通常降至约2/3。","counterplay_zh":"除雾可清除；劈瓦、精神之牙等可破坏墙；穿透可绕过部分防护。","parameters":{"duration_turns":5,"extended_duration_turns":8,"single_multiplier":"1/2","multi_multiplier":"2/3"},"source_locator":"moves.ts#lightscreen","relations":[{"entity_type":"move","identifier":"light-screen","relation_kind":"sets","note_zh":"设置光墙"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方光墙"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除光墙"}]},
    {"identifier":"aurora-veil","name_zh":"极光幕","aliases":["Aurora Veil"],"category":"side_condition","subcategory":"screen","scope":"side","generation_from":7,"description_zh":"同时降低物理和特殊招式伤害的墙类状态。","mechanics_zh":"通常只能在下雪或冰雹天气下成功设置；持续5回合，光之黏土可延长至8回合。","counterplay_zh":"天气条件只限制设置，不会因天气随后消失而立即解除；可被除雾或破墙招式清除。","parameters":{"duration_turns":5,"extended_duration_turns":8,"requires_weather":["snow","hail"]},"source_locator":"moves.ts#auroraveil","relations":[{"entity_type":"move","identifier":"aurora-veil","relation_kind":"sets","note_zh":"设置极光幕"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方极光幕"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除极光幕"}]},
    {"identifier":"safeguard","name_zh":"神秘守护","aliases":["Safeguard"],"category":"side_condition","subcategory":"status_protection","scope":"side","generation_from":2,"description_zh":"保护己方一侧免受多数由对手施加的主要异常与混乱。","mechanics_zh":"通常持续5回合；穿透可绕过，己方自行造成的状态及部分特殊来源不一定受阻。","counterplay_zh":"除雾可清除，换场可交换到另一侧。","parameters":{"duration_turns":5},"source_locator":"moves.ts#safeguard","relations":[{"entity_type":"move","identifier":"safeguard","relation_kind":"sets","note_zh":"设置神秘守护"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方神秘守护"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除神秘守护"}]},
    {"identifier":"mist","name_zh":"白雾","aliases":["白雾状态","Mist"],"category":"side_condition","subcategory":"stat_protection","scope":"side","generation_from":1,"description_zh":"保护己方一侧的能力阶级不被对手降低。","mechanics_zh":"当前规则通常持续5回合；主要阻止来自对手招式的负能力变化，不会阻止己方招式或自身效果造成的下降。","counterplay_zh":"穿透可绕过部分判定；除雾可清除，换场可交换。","parameters":{"duration_turns":5},"source_locator":"moves.ts#mist","relations":[{"entity_type":"move","identifier":"mist","relation_kind":"sets","note_zh":"设置白雾"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方白雾"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除白雾"}]},
    {"identifier":"tailwind","name_zh":"顺风","aliases":["Tailwind"],"category":"side_condition","subcategory":"speed_control","scope":"side","generation_from":4,"description_zh":"提高己方一侧全部宝可梦速度的队伍侧状态。","mechanics_zh":"当前规则持续4回合，己方宝可梦速度通常变为2倍。","counterplay_zh":"可用戏法空间、对方顺风或速度控制应对；换场可以交换双方顺风。","parameters":{"duration_turns":4,"speed_multiplier":2},"source_locator":"moves.ts#tailwind","relations":[{"entity_type":"move","identifier":"tailwind","relation_kind":"sets","note_zh":"设置顺风"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方顺风"}]},
    {"identifier":"spikes","name_zh":"撒菱","aliases":["地钉","Spikes"],"category":"side_condition","subcategory":"entry_hazard","scope":"side","generation_from":2,"description_zh":"对进入该侧场地且处于地面上的宝可梦造成伤害的入场陷阱。","mechanics_zh":"最多3层；通常分别造成最大HP的1/8、1/6和1/4伤害。飞行属性、飘浮或其他未着地状态通常不受影响。","counterplay_zh":"高速旋转、除雾等可处理；换场可交换双方陷阱。","parameters":{"max_layers":3,"grounded_only":true,"damage_by_layers":["1/8","1/6","1/4"]},"source_locator":"moves.ts#spikes","relations":[{"entity_type":"move","identifier":"spikes","relation_kind":"sets","note_zh":"设置一层撒菱"},{"entity_type":"move","identifier":"rapid-spin","relation_kind":"removes","note_zh":"清除己方一侧入场陷阱"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除场地陷阱"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方撒菱"}]},
    {"identifier":"toxic-spikes","name_zh":"毒菱","aliases":["毒钉","Toxic Spikes"],"category":"side_condition","subcategory":"entry_hazard","scope":"side","generation_from":4,"description_zh":"令进入该侧且处于地面上的宝可梦中毒的入场陷阱。","mechanics_zh":"最多2层；1层施加中毒，2层施加剧毒。处于地面的毒属性宝可梦会吸收并清除己方毒菱。","counterplay_zh":"高速旋转、除雾等可清除；换场可交换双方毒菱。","parameters":{"max_layers":2,"grounded_only":true},"source_locator":"moves.ts#toxicspikes","relations":[{"entity_type":"move","identifier":"toxic-spikes","relation_kind":"sets","note_zh":"设置一层毒菱"},{"entity_type":"move","identifier":"rapid-spin","relation_kind":"removes","note_zh":"清除己方毒菱"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除毒菱"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方毒菱"}]},
    {"identifier":"stealth-rock","name_zh":"隐形岩","aliases":["岩钉","Stealth Rock"],"category":"side_condition","subcategory":"entry_hazard","scope":"side","generation_from":4,"description_zh":"进入该侧场地时按岩石属性克制关系造成伤害的入场陷阱。","mechanics_zh":"基础伤害为最大HP的1/8，再乘以岩石属性对入场宝可梦的属性相性倍率；不要求目标着地。","counterplay_zh":"高速旋转、除雾等可清除；换场可交换双方隐形岩。","parameters":{"max_layers":1,"base_damage_fraction":"1/8","uses_rock_effectiveness":true},"source_locator":"moves.ts#stealthrock","relations":[{"entity_type":"move","identifier":"stealth-rock","relation_kind":"sets","note_zh":"设置隐形岩"},{"entity_type":"move","identifier":"rapid-spin","relation_kind":"removes","note_zh":"清除己方隐形岩"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除隐形岩"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方隐形岩"}]},
    {"identifier":"sticky-web","name_zh":"黏黏网","aliases":["虫网","Sticky Web"],"category":"side_condition","subcategory":"entry_hazard","scope":"side","generation_from":6,"description_zh":"降低进入该侧且处于地面上的宝可梦速度的入场陷阱。","mechanics_zh":"入场时通常令速度降低1级；飞行、飘浮及其他未着地状态通常不触发。","counterplay_zh":"高速旋转、除雾等可清除；换场可交换双方黏黏网。","parameters":{"max_layers":1,"grounded_only":true,"speed_stages":-1},"source_locator":"moves.ts#stickyweb","relations":[{"entity_type":"move","identifier":"sticky-web","relation_kind":"sets","note_zh":"设置黏黏网"},{"entity_type":"move","identifier":"rapid-spin","relation_kind":"removes","note_zh":"清除己方黏黏网"},{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"清除黏黏网"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方黏黏网"}]},
    {"identifier":"sea-of-fire","name_zh":"火海","aliases":["火之誓约组合状态","Sea of Fire"],"category":"side_condition","subcategory":"pledge_combo","scope":"side","generation_from":5,"description_zh":"火之誓约与草之誓约组合后施加在对方一侧的状态。","mechanics_zh":"通常持续4回合，回合末对非火属性宝可梦造成最大HP的1/8伤害。","counterplay_zh":"等待结束或利用火属性免疫伤害；换场可交换双方效果。","parameters":{"duration_turns":4,"residual_hp_fraction":"1/8"},"source_locator":"moves.ts#firepledge","relations":[{"entity_type":"move","identifier":"fire-pledge","relation_kind":"contributes","note_zh":"与草之誓约组合设置火海"},{"entity_type":"move","identifier":"grass-pledge","relation_kind":"contributes","note_zh":"与火之誓约组合设置火海"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方火海"}]},
    {"identifier":"swamp","name_zh":"湿地","aliases":["湿地状态","Swamp"],"category":"side_condition","subcategory":"pledge_combo","scope":"side","generation_from":5,"description_zh":"水之誓约与草之誓约组合后施加在对方一侧的状态。","mechanics_zh":"通常持续4回合，使该侧宝可梦速度降为原来的1/4。","counterplay_zh":"等待结束、使用速度控制或换场交换效果。","parameters":{"duration_turns":4,"speed_multiplier":"1/4"},"source_locator":"moves.ts#grasspledge","relations":[{"entity_type":"move","identifier":"water-pledge","relation_kind":"contributes","note_zh":"与草之誓约组合设置湿地"},{"entity_type":"move","identifier":"grass-pledge","relation_kind":"contributes","note_zh":"与水之誓约组合设置湿地"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方湿地"}]},
    {"identifier":"rainbow","name_zh":"彩虹","aliases":["彩虹状态","Rainbow"],"category":"side_condition","subcategory":"pledge_combo","scope":"side","generation_from":5,"description_zh":"火之誓约与水之誓约组合后施加在己方一侧的状态。","mechanics_zh":"通常持续4回合，使己方招式追加效果的发生概率翻倍；天恩等效果按规则叠加并受概率上限约束。","counterplay_zh":"等待结束或通过换场交换到另一侧。","parameters":{"duration_turns":4,"secondary_effect_multiplier":2},"source_locator":"moves.ts#waterpledge","relations":[{"entity_type":"move","identifier":"fire-pledge","relation_kind":"contributes","note_zh":"与水之誓约组合设置彩虹"},{"entity_type":"move","identifier":"water-pledge","relation_kind":"contributes","note_zh":"与火之誓约组合设置彩虹"},{"entity_type":"move","identifier":"court-change","relation_kind":"swaps","note_zh":"交换双方彩虹"}]},
    {"identifier":"wide-guard","name_zh":"广域防守状态","aliases":["广域防守","Wide Guard"],"category":"side_condition","subcategory":"one_turn_guard","scope":"side","generation_from":5,"description_zh":"在当前回合保护己方一侧免受多数范围攻击。","mechanics_zh":"优先度较高，只持续当前回合；连续使用会参与防守类招式的成功率判定。","counterplay_zh":"使用单体招式、佯攻等破防手段，或在其优先度之前行动。","parameters":{"duration_turns":1},"source_locator":"moves.ts#wideguard","relations":[{"entity_type":"move","identifier":"wide-guard","relation_kind":"sets","note_zh":"设置本回合广域防守"}]},
    {"identifier":"quick-guard","name_zh":"快速防守状态","aliases":["快速防守","Quick Guard"],"category":"side_condition","subcategory":"one_turn_guard","scope":"side","generation_from":5,"description_zh":"在当前回合保护己方一侧免受多数高优先度招式。","mechanics_zh":"只持续当前回合；保护对象按招式实际优先度判定。","counterplay_zh":"使用普通优先度招式或破防手段。","parameters":{"duration_turns":1},"source_locator":"moves.ts#quickguard","relations":[{"entity_type":"move","identifier":"quick-guard","relation_kind":"sets","note_zh":"设置本回合快速防守"}]},
    {"identifier":"sun","name_zh":"大晴天","aliases":["晴天","日照","sun","sunny day"],"category":"weather","subcategory":"standard_weather","scope":"field","generation_from":2,"description_zh":"强化火属性并削弱水属性的标准天气。","mechanics_zh":"通常持续5回合，炽热岩石可延长至8回合；火属性招式通常为1.5倍，水属性通常为0.5倍，并影响多种招式与特性。","counterplay_zh":"用其他天气覆盖、无关天气特性或等待持续时间结束。","parameters":{"duration_turns":5,"extended_duration_turns":8,"fire_multiplier":"3/2","water_multiplier":"1/2"},"source_locator":"moves.ts#sunnyday","relations":[{"entity_type":"move","identifier":"sunny-day","relation_kind":"sets","note_zh":"设置大晴天"},{"entity_type":"ability","identifier":"drought","relation_kind":"sets","note_zh":"出场时设置大晴天"}]},
    {"identifier":"rain","name_zh":"下雨","aliases":["雨天","降雨天气","rain","rain dance"],"category":"weather","subcategory":"standard_weather","scope":"field","generation_from":2,"description_zh":"强化水属性并削弱火属性的标准天气。","mechanics_zh":"通常持续5回合，潮湿岩石可延长至8回合；水属性招式通常为1.5倍，火属性通常为0.5倍，并影响命中、回复和多种特性。","counterplay_zh":"用其他天气覆盖、无关天气特性或等待持续时间结束。","parameters":{"duration_turns":5,"extended_duration_turns":8,"water_multiplier":"3/2","fire_multiplier":"1/2"},"source_locator":"moves.ts#raindance","relations":[{"entity_type":"move","identifier":"rain-dance","relation_kind":"sets","note_zh":"设置下雨"},{"entity_type":"ability","identifier":"drizzle","relation_kind":"sets","note_zh":"出场时设置下雨"}]},
    {"identifier":"sandstorm","name_zh":"沙暴","aliases":["沙暴天气","sandstorm"],"category":"weather","subcategory":"standard_weather","scope":"field","generation_from":2,"description_zh":"造成持续伤害并强化岩石属性特殊耐久的天气。","mechanics_zh":"通常持续5回合，沙沙岩石可延长至8回合；非岩石、地面、钢属性且无保护效果的宝可梦每回合通常损失1/16最大HP，岩石属性特防为1.5倍。","counterplay_zh":"用其他天气覆盖、利用免疫属性/特性或等待结束。","parameters":{"duration_turns":5,"extended_duration_turns":8,"residual_hp_fraction":"1/16","rock_spdef_multiplier":"3/2"},"source_locator":"moves.ts#sandstorm","relations":[{"entity_type":"move","identifier":"sandstorm","relation_kind":"sets","note_zh":"设置沙暴"},{"entity_type":"ability","identifier":"sand-stream","relation_kind":"sets","note_zh":"出场时设置沙暴"}]},
    {"identifier":"snow","name_zh":"下雪","aliases":["雪天","冰雪天气","snow","snowscape"],"category":"weather","subcategory":"standard_weather","scope":"field","generation_from":9,"description_zh":"第九世代取代冰雹的标准冰系天气。","mechanics_zh":"通常持续5回合，冰冷岩石可延长至8回合；冰属性宝可梦防御通常为1.5倍，本身不造成回合伤害。","counterplay_zh":"用其他天气覆盖或等待结束。","parameters":{"duration_turns":5,"extended_duration_turns":8,"ice_defense_multiplier":"3/2"},"source_locator":"moves.ts#snowscape","relations":[{"entity_type":"move","identifier":"snowscape","relation_kind":"sets","note_zh":"设置下雪"},{"entity_type":"ability","identifier":"snow-warning","relation_kind":"sets","note_zh":"出场时设置下雪"}]},
    {"identifier":"hail","name_zh":"冰雹","aliases":["冰雹天气","hail"],"category":"weather","subcategory":"historical_weather","scope":"field","generation_from":3,"generation_to":8,"current":false,"description_zh":"第八世代及以前的冰系伤害天气，后来由下雪取代。","mechanics_zh":"通常持续5回合；非冰属性且无保护效果的宝可梦每回合损失最大HP的1/16。","counterplay_zh":"用其他天气覆盖、利用免疫属性/特性或等待结束。","parameters":{"duration_turns":5,"residual_hp_fraction":"1/16"},"source_locator":"moves.ts#hail","relations":[{"entity_type":"move","identifier":"hail","relation_kind":"sets","note_zh":"历史规则中设置冰雹"}]},
    {"identifier":"extreme-sunlight","name_zh":"大日照","aliases":["终结之地天气","强烈日照","extremely harsh sunlight"],"category":"weather","subcategory":"primal_weather","scope":"field","generation_from":6,"description_zh":"由终结之地提供的强力日照。","mechanics_zh":"在来源宝可梦保持有效时持续；除保留普通晴天效果外，通常令水属性攻击招式无法发动，普通天气不能覆盖。","counterplay_zh":"令来源宝可梦离场、失去特性或用另一种原始天气/气流覆盖。","parameters":{"duration":"while_source_active","blocks_type":"water"},"source_locator":"abilities.ts#desolateland","relations":[{"entity_type":"ability","identifier":"desolate-land","relation_kind":"sets","note_zh":"在场时维持大日照"}]},
    {"identifier":"heavy-rain","name_zh":"大雨","aliases":["始源之海天气","强降雨","heavy rain"],"category":"weather","subcategory":"primal_weather","scope":"field","generation_from":6,"description_zh":"由始源之海提供的强力降雨。","mechanics_zh":"在来源宝可梦保持有效时持续；除保留普通雨天效果外，通常令火属性攻击招式无法发动，普通天气不能覆盖。","counterplay_zh":"令来源宝可梦离场、失去特性或用另一种原始天气/气流覆盖。","parameters":{"duration":"while_source_active","blocks_type":"fire"},"source_locator":"abilities.ts#primordialsea","relations":[{"entity_type":"ability","identifier":"primordial-sea","relation_kind":"sets","note_zh":"在场时维持大雨"}]},
    {"identifier":"strong-winds","name_zh":"乱流","aliases":["德尔塔气流天气","强风","strong winds"],"category":"weather","subcategory":"primal_weather","scope":"field","generation_from":6,"description_zh":"由德尔塔气流提供的特殊气流天气。","mechanics_zh":"在来源宝可梦保持有效时持续；会消除飞行属性宝可梦因自身飞行属性产生的弱点倍率，普通天气不能覆盖。","counterplay_zh":"令来源宝可梦离场、失去特性或用原始天气覆盖。","parameters":{"duration":"while_source_active"},"source_locator":"abilities.ts#deltastream","relations":[{"entity_type":"ability","identifier":"delta-stream","relation_kind":"sets","note_zh":"在场时维持乱流"}]},
    {"identifier":"fog","name_zh":"起雾","aliases":["雾天气","fog"],"category":"weather","subcategory":"historical_weather","scope":"field","generation_from":3,"generation_to":4,"current":false,"description_zh":"部分旧作地点战斗中的特殊天气。","mechanics_zh":"通常降低招式命中率，并与除雾等招式互动；当前第九世代标准对战不使用该天气。","counterplay_zh":"旧作中可用除雾清除。","parameters":{"current_standard":false},"source_locator":"moves.ts#defog","relations":[{"entity_type":"move","identifier":"defog","relation_kind":"removes","note_zh":"旧作中清除雾天气"}]},
    {"identifier":"electric-terrain","name_zh":"电气场地","aliases":["电场","Electric Terrain"],"category":"terrain","subcategory":"standard_terrain","scope":"field","generation_from":6,"description_zh":"强化地面上的电属性攻击并防止睡眠的场地。","mechanics_zh":"通常持续5回合，场地延长道具可延长至8回合；当前规则下地面上的宝可梦使用电属性招式通常为1.3倍，且不会陷入睡眠。","counterplay_zh":"用其他场地覆盖、清除场地或利用未着地状态避开多数效果。","parameters":{"duration_turns":5,"extended_duration_turns":8,"grounded_only":true,"type_multiplier":"1.3"},"source_locator":"moves.ts#electricterrain","relations":[{"entity_type":"move","identifier":"electric-terrain","relation_kind":"sets","note_zh":"设置电气场地"},{"entity_type":"ability","identifier":"electric-surge","relation_kind":"sets","note_zh":"出场时设置电气场地"}]},
    {"identifier":"grassy-terrain","name_zh":"青草场地","aliases":["草场","Grassy Terrain"],"category":"terrain","subcategory":"standard_terrain","scope":"field","generation_from":6,"description_zh":"强化地面上的草属性攻击并持续回复HP的场地。","mechanics_zh":"通常持续5回合；当前规则下地面上的草属性招式通常为1.3倍，每回合回复最大HP的1/16，并削弱地震、重踏和震级。","counterplay_zh":"用其他场地覆盖、清除场地或利用未着地状态避开多数效果。","parameters":{"duration_turns":5,"extended_duration_turns":8,"grounded_only":true,"type_multiplier":"1.3","healing_fraction":"1/16"},"source_locator":"moves.ts#grassyterrain","relations":[{"entity_type":"move","identifier":"grassy-terrain","relation_kind":"sets","note_zh":"设置青草场地"},{"entity_type":"ability","identifier":"grassy-surge","relation_kind":"sets","note_zh":"出场时设置青草场地"}]},
    {"identifier":"misty-terrain","name_zh":"薄雾场地","aliases":["雾场","Misty Terrain"],"category":"terrain","subcategory":"standard_terrain","scope":"field","generation_from":6,"description_zh":"保护地面上的宝可梦免受状态并削弱龙属性攻击的场地。","mechanics_zh":"通常持续5回合；地面上的宝可梦不会被施加主要异常或混乱，受到的龙属性招式威力通常减半。","counterplay_zh":"用其他场地覆盖、清除场地；未着地的宝可梦不受多数保护。","parameters":{"duration_turns":5,"extended_duration_turns":8,"grounded_only":true,"dragon_multiplier":"1/2"},"source_locator":"moves.ts#mistyterrain","relations":[{"entity_type":"move","identifier":"misty-terrain","relation_kind":"sets","note_zh":"设置薄雾场地"},{"entity_type":"ability","identifier":"misty-surge","relation_kind":"sets","note_zh":"出场时设置薄雾场地"}]},
    {"identifier":"psychic-terrain","name_zh":"精神场地","aliases":["超能场","Psychic Terrain"],"category":"terrain","subcategory":"standard_terrain","scope":"field","generation_from":7,"description_zh":"强化地面上的超能力招式并阻挡针对目标的高优先度招式的场地。","mechanics_zh":"通常持续5回合；当前规则下地面上的宝可梦使用超能力招式通常为1.3倍，且地面目标不会被对手的优先度大于0招式命中。","counterplay_zh":"用其他场地覆盖、清除场地或利用未着地状态改变适用关系。","parameters":{"duration_turns":5,"extended_duration_turns":8,"grounded_only":true,"type_multiplier":"1.3"},"source_locator":"moves.ts#psychicterrain","relations":[{"entity_type":"move","identifier":"psychic-terrain","relation_kind":"sets","note_zh":"设置精神场地"},{"entity_type":"ability","identifier":"psychic-surge","relation_kind":"sets","note_zh":"出场时设置精神场地"}]},
    {"identifier":"trick-room","name_zh":"戏法空间","aliases":["空间队状态","Trick Room"],"category":"field_condition","subcategory":"room","scope":"field","generation_from":4,"description_zh":"改变同一优先度内行动顺序的全场空间状态。","mechanics_zh":"持续5回合；在相同优先度范围内，速度较低者通常先行动，但招式优先度仍先于速度比较。再次成功使用会解除。","counterplay_zh":"再次使用戏法空间、拖过持续时间，或使用低速宝可梦反向利用。","parameters":{"duration_turns":5,"reverses_speed_order":true},"source_locator":"moves.ts#trickroom","relations":[{"entity_type":"move","identifier":"trick-room","relation_kind":"toggles","note_zh":"设置或解除戏法空间"}]},
    {"identifier":"magic-room","name_zh":"魔法空间","aliases":["Magic Room"],"category":"field_condition","subcategory":"room","scope":"field","generation_from":5,"description_zh":"暂时使场上宝可梦携带道具失效的全场空间状态。","mechanics_zh":"持续5回合；道具通常仍被携带但效果被压制，再次成功使用会解除。","counterplay_zh":"再次使用魔法空间或等待结束。","parameters":{"duration_turns":5,"suppresses_held_items":true},"source_locator":"moves.ts#magicroom","relations":[{"entity_type":"move","identifier":"magic-room","relation_kind":"toggles","note_zh":"设置或解除魔法空间"}]},
    {"identifier":"wonder-room","name_zh":"奇妙空间","aliases":["Wonder Room"],"category":"field_condition","subcategory":"room","scope":"field","generation_from":5,"description_zh":"交换防御与特防在伤害计算中作用的全场空间状态。","mechanics_zh":"持续5回合；主要交换防御和特防数值的使用方式，再次成功使用会解除。","counterplay_zh":"再次使用奇妙空间或等待结束。","parameters":{"duration_turns":5,"swaps_defense_stats":true},"source_locator":"moves.ts#wonderroom","relations":[{"entity_type":"move","identifier":"wonder-room","relation_kind":"toggles","note_zh":"设置或解除奇妙空间"}]},
    {"identifier":"gravity","name_zh":"重力","aliases":["重力状态","Gravity"],"category":"field_condition","subcategory":"global_rule","scope":"field","generation_from":4,"description_zh":"令宝可梦更容易命中并使空中单位落地的全场状态。","mechanics_zh":"持续5回合；使飞行、飘浮等宝可梦着地，招式命中率按5/3修正，并禁止飞翔、弹跳、电磁飘浮等部分招式。","counterplay_zh":"等待结束；不能用普通场地覆盖。","parameters":{"duration_turns":5,"accuracy_multiplier":"5/3","grounds_targets":true},"source_locator":"moves.ts#gravity","relations":[{"entity_type":"move","identifier":"gravity","relation_kind":"sets","note_zh":"设置重力"}]},
    {"identifier":"fairy-lock","name_zh":"妖精之锁状态","aliases":["妖精之锁","Fairy Lock"],"category":"field_condition","subcategory":"switch_restriction","scope":"field","generation_from":6,"description_zh":"短暂阻止场上宝可梦替换或逃走的全场效果。","mechanics_zh":"通常只影响下一回合的替换判定，随后结束。","counterplay_zh":"利用幽灵属性、强制换人或等待效果结束，具体取决于目标规则。","parameters":{"duration_turns":1},"source_locator":"moves.ts#fairylock","relations":[{"entity_type":"move","identifier":"fairy-lock","relation_kind":"sets","note_zh":"设置妖精之锁"}]},
    {"identifier":"dark-aura","name_zh":"暗黑气场","aliases":["恶之气场","Dark Aura"],"category":"aura","subcategory":"type_aura","scope":"field","generation_from":6,"description_zh":"由暗黑气场特性在场时提供的恶属性招式强化效果。","mechanics_zh":"场上宝可梦使用的恶属性招式威力通常变为4/3；多个同名气场不会简单重复相乘。","counterplay_zh":"令来源离场、压制特性，或用气场破坏反转效果。","parameters":{"type":"dark","power_multiplier":"4/3","duration":"while_source_active"},"source_locator":"abilities.ts#darkaura","relations":[{"entity_type":"ability","identifier":"dark-aura","relation_kind":"provides","note_zh":"在场时提供暗黑气场"}]},
    {"identifier":"fairy-aura","name_zh":"妖精气场","aliases":["Fairy Aura"],"category":"aura","subcategory":"type_aura","scope":"field","generation_from":6,"description_zh":"由妖精气场特性在场时提供的妖精属性招式强化效果。","mechanics_zh":"场上宝可梦使用的妖精属性招式威力通常变为4/3；多个同名气场不会简单重复相乘。","counterplay_zh":"令来源离场、压制特性，或用气场破坏反转效果。","parameters":{"type":"fairy","power_multiplier":"4/3","duration":"while_source_active"},"source_locator":"abilities.ts#fairyaura","relations":[{"entity_type":"ability","identifier":"fairy-aura","relation_kind":"provides","note_zh":"在场时提供妖精气场"}]},
    {"identifier":"aura-break","name_zh":"气场破坏效果","aliases":["气场反转","Aura Break"],"category":"aura","subcategory":"aura_modifier","scope":"field","generation_from":6,"description_zh":"反转暗黑气场与妖精气场增益的全场特性效果。","mechanics_zh":"存在气场破坏时，相关气场不再强化，而通常改为把对应属性招式威力变为3/4。","counterplay_zh":"令气场破坏来源离场或压制其特性。","parameters":{"affected_auras":["dark-aura","fairy-aura"],"reversed_multiplier":"3/4","duration":"while_source_active"},"source_locator":"abilities.ts#aurabreak","relations":[{"entity_type":"ability","identifier":"aura-break","relation_kind":"provides","note_zh":"在场时反转两种属性气场"}]},
    {"identifier":"tablets-of-ruin","name_zh":"古简蜗灾祸气场","aliases":["古简蜗气场","Tablets of Ruin"],"category":"aura","subcategory":"ruin_aura","scope":"field","generation_from":9,"description_zh":"由古简蜗的特性提供、降低其他宝可梦攻击的全场效果。","mechanics_zh":"除特性持有者外，场上宝可梦的攻击通常乘以3/4；同类灾祸效果按引擎规则处理。","counterplay_zh":"令来源离场、压制或无效化特性。","parameters":{"affected_stat":"attack","stat_multiplier":"3/4","duration":"while_source_active"},"source_locator":"abilities.ts#tabletsofruin","relations":[{"entity_type":"ability","identifier":"tablets-of-ruin","relation_kind":"provides","note_zh":"在场时提供攻击削弱气场"}]},
    {"identifier":"sword-of-ruin","name_zh":"古剑豹灾祸气场","aliases":["古剑豹气场","Sword of Ruin"],"category":"aura","subcategory":"ruin_aura","scope":"field","generation_from":9,"description_zh":"由古剑豹的特性提供、降低其他宝可梦防御的全场效果。","mechanics_zh":"除特性持有者外，场上宝可梦的防御通常乘以3/4。","counterplay_zh":"令来源离场、压制或无效化特性。","parameters":{"affected_stat":"defense","stat_multiplier":"3/4","duration":"while_source_active"},"source_locator":"abilities.ts#swordofruin","relations":[{"entity_type":"ability","identifier":"sword-of-ruin","relation_kind":"provides","note_zh":"在场时提供防御削弱气场"}]},
    {"identifier":"vessel-of-ruin","name_zh":"古鼎鹿灾祸气场","aliases":["古鼎鹿气场","Vessel of Ruin"],"category":"aura","subcategory":"ruin_aura","scope":"field","generation_from":9,"description_zh":"由古鼎鹿的特性提供、降低其他宝可梦特攻的全场效果。","mechanics_zh":"除特性持有者外，场上宝可梦的特攻通常乘以3/4。","counterplay_zh":"令来源离场、压制或无效化特性。","parameters":{"affected_stat":"special-attack","stat_multiplier":"3/4","duration":"while_source_active"},"source_locator":"abilities.ts#vesselofruin","relations":[{"entity_type":"ability","identifier":"vessel-of-ruin","relation_kind":"provides","note_zh":"在场时提供特攻削弱气场"}]},
