{
  "schema_version": 1,
  "default_generation": 9,
  "default_ruleset": "scarlet-violet",
  "description": "第九世代标准主系列规则的顶层精确机制摘要；没有指定版本时使用。",
  "entries": [
    {"entity_type":"item","identifier":"master-ball","summary_zh":"捕获必定成功（捕获倍率可视为无限；训练家对战不可用）。","parameters":{"catch":"guaranteed"}},
    {"entity_type":"item","identifier":"poke-ball","summary_zh":"基础捕获倍率为 1×。","parameters":{"catch_multiplier":1.0}},
    {"entity_type":"item","identifier":"great-ball","summary_zh":"捕获倍率为 1.5×。","parameters":{"catch_multiplier":1.5}},
    {"entity_type":"item","identifier":"ultra-ball","summary_zh":"捕获倍率为 2×。","parameters":{"catch_multiplier":2.0}},
    {"entity_type":"item","identifier":"safari-ball","summary_zh":"捕获倍率为 1.5×；只在特定狩猎区域或作品规则中使用。","parameters":{"catch_multiplier":1.5}},
    {"entity_type":"item","identifier":"net-ball","summary_zh":"目标为水属性或虫属性时捕获倍率为 3.5×，否则为 1×。","parameters":{"conditional_multiplier":3.5,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"dive-ball","summary_zh":"在水上、钓鱼或水下遭遇等适用场景中捕获倍率为 3.5×，否则为 1×。","parameters":{"conditional_multiplier":3.5,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"nest-ball","summary_zh":"目标等级越低倍率越高：约为 max((41－目标等级)÷10, 1)，1级最高 4×，30级及以上为 1×。","parameters":{"formula":"max((41-target_level)/10,1)","maximum_multiplier":4.0,"minimum_multiplier":1.0}},
    {"entity_type":"item","identifier":"repeat-ball","summary_zh":"目标种类已经捕获并登记时为 3.5×，否则为 1×。","parameters":{"conditional_multiplier":3.5,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"timer-ball","summary_zh":"随战斗经过的回合增加倍率，每经过1回合约增加 0.3×，最高 4×。","parameters":{"increase_per_turn":0.3,"maximum_multiplier":4.0}},
    {"entity_type":"item","identifier":"luxury-ball","summary_zh":"捕获倍率为 1×；捕获后的宝可梦更容易提高亲密度。","parameters":{"catch_multiplier":1.0}},
    {"entity_type":"item","identifier":"premier-ball","summary_zh":"捕获倍率为 1×。","parameters":{"catch_multiplier":1.0}},
    {"entity_type":"item","identifier":"dusk-ball","summary_zh":"夜晚或洞窟等适用环境中为 3×，否则为 1×。","parameters":{"conditional_multiplier":3.0,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"heal-ball","summary_zh":"捕获倍率为 1×；成功捕获后立即回复HP并治愈异常状态。","parameters":{"catch_multiplier":1.0}},
    {"entity_type":"item","identifier":"quick-ball","summary_zh":"战斗第1回合为 5×，之后为 1×。","parameters":{"first_turn_multiplier":5.0,"later_multiplier":1.0}},
    {"entity_type":"item","identifier":"cherish-ball","summary_zh":"捕获倍率为 1×；通常作为活动赠送宝可梦的专用球。","parameters":{"catch_multiplier":1.0}},
    {"entity_type":"item","identifier":"sport-ball","summary_zh":"捕获倍率为 1.5×。","parameters":{"catch_multiplier":1.5}},
    {"entity_type":"item","identifier":"dream-ball","summary_zh":"目标处于睡眠状态时为 4×，否则为 1×。","parameters":{"conditional_multiplier":4.0,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"beast-ball","summary_zh":"捕捉究极异兽时为 5×；捕捉其他宝可梦时只有 0.1×。","parameters":{"ultra_beast_multiplier":5.0,"other_multiplier":0.1}},
    {"entity_type":"item","identifier":"fast-ball","summary_zh":"目标种族速度不低于100时为 4×，否则为 1×。","parameters":{"conditional_multiplier":4.0,"speed_threshold":100,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"level-ball","summary_zh":"按我方与目标等级比计算：不高于目标为1×；高于目标为2×；至少2倍等级为4×；至少4倍等级为8×。","parameters":{"multipliers":[1,2,4,8]}},
    {"entity_type":"item","identifier":"lure-ball","summary_zh":"以钓鱼方式遇到的目标为 5×，否则为 1×。","parameters":{"conditional_multiplier":5.0,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"moon-ball","summary_zh":"能使用月之石进化的目标为 4×，否则为 1×。","parameters":{"conditional_multiplier":4.0,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"love-ball","summary_zh":"与出战宝可梦种类相同且性别相反时为 8×，否则为 1×。","parameters":{"conditional_multiplier":8.0,"default_multiplier":1.0}},
    {"entity_type":"item","identifier":"friend-ball","summary_zh":"捕获倍率为 1×；成功捕获后目标的初始亲密度变为较高值。","parameters":{"catch_multiplier":1.0}},
    {"entity_type":"item","identifier":"heavy-ball","summary_zh":"不使用倍率而直接修正捕获率：目标低于100kg时－20；100～199.9kg不修正；200～299.9kg时＋20；至少300kg时＋30。","parameters":{"catch_rate_additions":{"lt_100kg":-20,"100_to_199_9kg":0,"200_to_299_9kg":20,"gte_300kg":30}}},

    {"entity_type":"item","identifier":"life-orb","summary_zh":"造成伤害的招式威力为 1.3×；命中后损失最大HP的 10%。","parameters":{"damage_multiplier":1.3,"max_hp_recoil":0.1}},
    {"entity_type":"item","identifier":"choice-band","summary_zh":"攻击变为 1.5×，但通常只能连续选择同一个招式，直到离场或失去道具。","parameters":{"attack_multiplier":1.5}},
    {"entity_type":"item","identifier":"choice-specs","summary_zh":"特攻变为 1.5×，但通常只能连续选择同一个招式，直到离场或失去道具。","parameters":{"special_attack_multiplier":1.5}},
    {"entity_type":"item","identifier":"choice-scarf","summary_zh":"速度变为 1.5×，但通常只能连续选择同一个招式，直到离场或失去道具。","parameters":{"speed_multiplier":1.5}},
    {"entity_type":"item","identifier":"muscle-band","summary_zh":"物理招式威力为 1.1×。","parameters":{"physical_damage_multiplier":1.1}},
    {"entity_type":"item","identifier":"wise-glasses","summary_zh":"特殊招式威力为 1.1×。","parameters":{"special_damage_multiplier":1.1}},
    {"entity_type":"item","identifier":"expert-belt","summary_zh":"效果绝佳的招式威力为 1.2×。","parameters":{"super_effective_damage_multiplier":1.2}},
    {"entity_type":"item","identifier":"assault-vest","summary_zh":"特防变为 1.5×，但不能选择变化招式。","parameters":{"special_defense_multiplier":1.5}},
    {"entity_type":"item","identifier":"eviolite","summary_zh":"尚能进化的宝可梦携带时，防御和特防均变为 1.5×。","parameters":{"defense_multiplier":1.5,"special_defense_multiplier":1.5}},
    {"entity_type":"item","identifier":"leftovers","summary_zh":"每回合结束回复最大HP的 1/16。","parameters":{"max_hp_heal_per_turn":0.0625}},
    {"entity_type":"item","identifier":"black-sludge","summary_zh":"毒属性宝可梦每回合回复最大HP的 1/16；非毒属性宝可梦每回合损失最大HP的 1/8。","parameters":{"poison_heal":0.0625,"other_damage":0.125}},
    {"entity_type":"item","identifier":"rocky-helmet","summary_zh":"受到接触类招式攻击时，攻击方损失其最大HP的 1/6。","parameters":{"attacker_max_hp_damage":0.1666667}},
    {"entity_type":"item","identifier":"shell-bell","summary_zh":"使用攻击招式造成伤害后，回复所造成伤害的 1/8。","parameters":{"damage_dealt_heal":0.125}},
    {"entity_type":"item","identifier":"light-ball","summary_zh":"皮卡丘携带时，攻击和特攻均变为 2×。","parameters":{"attack_multiplier":2.0,"special_attack_multiplier":2.0}},
    {"entity_type":"item","identifier":"thick-club","summary_zh":"卡拉卡拉或嘎啦嘎啦携带时，攻击变为 2×。","parameters":{"attack_multiplier":2.0}},

    {"entity_type":"ability","identifier":"sheer-force","summary_zh":"带有可被移除追加效果的招式威力为 1.3×，同时取消这些追加效果。","parameters":{"damage_multiplier":1.3}},
    {"entity_type":"ability","identifier":"huge-power","summary_zh":"攻击变为 2×。","parameters":{"attack_multiplier":2.0}},
    {"entity_type":"ability","identifier":"pure-power","summary_zh":"攻击变为 2×。","parameters":{"attack_multiplier":2.0}},
    {"entity_type":"ability","identifier":"technician","summary_zh":"基础威力不高于60的招式威力为 1.5×。","parameters":{"damage_multiplier":1.5,"maximum_base_power":60}},
    {"entity_type":"ability","identifier":"adaptability","summary_zh":"本属性一致加成由通常的 1.5×提高为 2×。","parameters":{"stab_multiplier":2.0}},
    {"entity_type":"ability","identifier":"static","summary_zh":"受到接触类招式攻击时，有 30% 概率使攻击方麻痹。","parameters":{"contact_paralysis_chance":0.3}},
    {"entity_type":"ability","identifier":"guts","summary_zh":"陷入异常状态时攻击变为 1.5×；灼伤造成的攻击降低也会被忽略。","parameters":{"attack_multiplier":1.5}},
    {"entity_type":"ability","identifier":"marvel-scale","summary_zh":"陷入异常状态时防御变为 1.5×。","parameters":{"defense_multiplier":1.5}},
    {"entity_type":"ability","identifier":"quick-feet","summary_zh":"陷入异常状态时速度变为 1.5×，并忽略麻痹造成的速度降低。","parameters":{"speed_multiplier":1.5}},
    {"entity_type":"ability","identifier":"hustle","summary_zh":"物理攻击使用的攻击数值变为 1.5×，但物理招式命中率变为 0.8×。","parameters":{"attack_multiplier":1.5,"physical_accuracy_multiplier":0.8}},
    {"entity_type":"ability","identifier":"solar-power","summary_zh":"晴朗天气时特攻变为 1.5×，每回合损失最大HP的 1/8。","parameters":{"special_attack_multiplier":1.5,"max_hp_loss_per_turn":0.125}},
    {"entity_type":"ability","identifier":"analytic","summary_zh":"在本回合最后行动时，招式威力为 1.3×。","parameters":{"damage_multiplier":1.3}},
    {"entity_type":"ability","identifier":"reckless","summary_zh":"具有反作用伤害或特定自损性质的招式威力为 1.2×。","parameters":{"damage_multiplier":1.2}},
    {"entity_type":"ability","identifier":"iron-fist","summary_zh":"拳类招式威力为 1.2×。","parameters":{"damage_multiplier":1.2}},
    {"entity_type":"ability","identifier":"strong-jaw","summary_zh":"啃咬类招式威力为 1.5×。","parameters":{"damage_multiplier":1.5}},
    {"entity_type":"ability","identifier":"tough-claws","summary_zh":"接触类招式威力为 1.3×。","parameters":{"damage_multiplier":1.3}},
    {"entity_type":"ability","identifier":"tinted-lens","summary_zh":"对效果不佳目标造成的伤害变为 2×，相当于抵消一级属性抗性。","parameters":{"resisted_damage_multiplier":2.0}},
    {"entity_type":"ability","identifier":"punk-rock","summary_zh":"自己使用的声音类招式威力为 1.3×；受到声音类招式的伤害变为 0.5×。","parameters":{"sound_damage_multiplier":1.3,"received_sound_damage_multiplier":0.5}},
    {"entity_type":"ability","identifier":"steelworker","summary_zh":"钢属性招式威力为 1.5×。","parameters":{"steel_damage_multiplier":1.5}},
    {"entity_type":"ability","identifier":"dragons-maw","summary_zh":"龙属性招式威力为 1.5×。","parameters":{"dragon_damage_multiplier":1.5}},
    {"entity_type":"ability","identifier":"steely-spirit","summary_zh":"己方宝可梦使用的钢属性招式威力为 1.5×。","parameters":{"steel_damage_multiplier":1.5}},
    {"entity_type":"ability","identifier":"transistor","summary_zh":"第九世代中，电属性招式威力为 1.3×。","parameters":{"electric_damage_multiplier":1.3}},
    {"entity_type":"ability","identifier":"sharpness","summary_zh":"切割类招式威力为 1.5×。","parameters":{"slicing_damage_multiplier":1.5}},
    {"entity_type":"ability","identifier":"rocky-payload","summary_zh":"岩石属性招式威力为 1.5×。","parameters":{"rock_damage_multiplier":1.5}},
    {"entity_type":"ability","identifier":"supreme-overlord","summary_zh":"每有1只同伴在本次战斗中倒下，招式威力提高10%；最多计算5只，即最高 1.5×。","parameters":{"increase_per_fainted_ally":0.1,"maximum_multiplier":1.5}}
  ]
}
